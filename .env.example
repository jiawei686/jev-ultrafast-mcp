# Optional. Without these the full observe/act/assert surface still works.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# The decision model is Jev. It is reachable by more than one route, and every
# route speaks the same {model, state, questions} contract -- only the URL and
# whose credits pay change.
#
#   TypeSafe direct (default)   TYPESAFE_API_KEY only
#   OpenRouter Decisions route  set TYPESAFE_BASE_URL below and use your
#                               OPENROUTER_API_KEY; no TypeSafe account needed.
#                               Model slugs that validate: jev-latest,
#                               typesafe/jev-1.13, ~typesafe/jev-latest.
#                               No :free variant exists, so OpenRouter needs a
#                               credits purchase (~$0.042/M input tokens,
#                               output not billed).
#
# TYPESAFE_BASE_URL=https://openrouter.ai/api/alpha/decisions

# Only needed for TYPE_TEXT while running browser_goal (turbo mode).
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-chat

# Browser
JEVMCP_HEADLESS=1
JEVMCP_FOREGROUND=0
# JEVMCP_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# JEVMCP_MODE=attach
# JEVMCP_CDP_URL=http://127.0.0.1:9222

# Policy envelope
# JEVMCP_ALLOW_DOMAINS=example.com,*.mycompany.com
# JEVMCP_DENY_DOMAINS=admin.example.com
JEVMCP_ALLOW_JS=0
JEVMCP_ALLOW_UPLOADS=1
JEVMCP_MAX_ACTIONS=250
JEVMCP_MAX_TEXT=6000
